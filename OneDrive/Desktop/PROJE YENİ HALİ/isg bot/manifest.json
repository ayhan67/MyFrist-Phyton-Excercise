{
   "background": {
      "service_worker": "service-worker.js",
      "type": "module"
   },
   "content_scripts": [],
   "description": "İSG Katip sözleşme ve personel yönetimini otomatikleştiren Chrome uzantısı. Zamandan tasarruf edin, hata riskini minimize edin.",
   "host_permissions": [
      "https://isgkatip.csgb.gov.tr/*",
      "https://isgpratik.com/*",
      "https://www.isgpratik.com/*",
      "https://isgpratik.com.tr/*",
      "https://www.isgpratik.com.tr/*",
      "https://*.isgpratik.com.tr/*",
      "http://localhost:3000/*"
   ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "İSGPratik Bot",
   "permissions": [
      "storage",
      "scripting",
      "clipboardWrite",
      "activeTab"
   ],
   "externally_connectable": {
      "matches": [
         "https://isgpratik.com/*",
         "https://www.isgpratik.com/*",
         "https://isgpratik.com.tr/*",
         "https://www.isgpratik.com.tr/*",
         "https://*.isgpratik.com.tr/*",
         "http://localhost:3000/*"
      ]
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.4.32",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": []
      }
   ]
}