{
    "manifest_version": 3,
    "name": "İSG Destek",
    "version": "1.3.7",
    "description": "İSG Katip verilerini İSG Destek OSGB sisteminizle senkronize eder.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://isgkatip.csgb.gov.tr/*",
        "https://isgdestek.com.tr/*",
        "http://localhost:3000/*",
        "http://localhost:5005/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://isgkatip.csgb.gov.tr/*",
                "http://localhost/*",
                "http://localhost:3000/*",
                "http://localhost:5173/*",
                "https://isgdestek.com.tr/*",
                "https://*.isgdestek.com.tr/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        },
        {
            "matches": [
                "http://localhost/*",
                "http://localhost:3000/*",
                "http://localhost:5173/*",
                "https://isgdestek.com.tr/*",
                "https://*.isgdestek.com.tr/*"
            ],
            "js": [
                "osgb_connector.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}